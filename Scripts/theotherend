#!/usr/bin/env bash

# Local file setup
readonly program="$(realpath "${0}")"
readonly feeds_dir="$(dirname "$(dirname "${program}")")/Feeds"
readonly feed_file="${feeds_dir}/$(basename "${program}").json"
readonly tmp_file="$(mktemp)"

# Initial feed setup
[[ -f "${feed_file}" ]] || printf '{
  "version": "https://jsonfeed.org/version/1.1",
  "title": "%s",
  "home_page_url": "%s",
  "items": []
}' 'The Other End' 'https://tinyview.com/the-other-end/' > "${feed_file}"

# Strategy to get feed details
readonly source_url='https://www.patreon.com/api/collection/2410855?include=posts&fields%5Bpost%5D=title,url&json-api-version=1.0'
readonly top_entry="$(curl --silent "${source_url}" | jq '[.included[]? | select(.type == "post")] | first')"
readonly top_id="$(jq --raw-output '.id' <<< "${top_entry}")"
readonly top_url="$(jq --raw-output '.attributes.url' <<< "${top_entry}")"
readonly top_title="$(jq --raw-output '.attributes.title' <<< "${top_entry}")"

# Exit early if item already in feed
[[ "$(jq --raw-output '.items[0].id' "${feed_file}")" == "${top_id}" ]] && exit 0

# Add to feed, keeping only the most recent five
jq \
  --arg id "${top_id}" \
  --arg url "${top_url}" \
  --arg title "${top_title}" \
  '.items = ([{ id: $id, url: $url, title: $title }] + (.items // [])) | .items = (.items[0:5])' \
  "${feed_file}" > "${tmp_file}"

mv "${tmp_file}" "${feed_file}"
